TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
# Local (France/EU) : bybit | Railway (USA) : kucoin
EXCHANGE=bybit
EXCHANGE_FALLBACK=false
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log

# ----- Paper trading (trader_main.py) -----
# Mise de depart en USDT
START_BALANCE=1000
# % du solde engage par trade (100 = tout le solde, sans levier)
POSITION_PCT=100
# Timeframe des signaux en minutes (30 = valide par backtest 12 mois)
SIGNAL_TF_MIN=30
# Longueur de l'EMA "ligne grise" (au-dessus = long, en dessous = short)
EMA_LEN=20
# Stop initial et trailing en multiples d'ATR
STOP_ATR=2.5
TRAIL_ATR=3.0
# Filtre efficiency ratio : plus bas = plus de trades (0.25-0.40)
ER_MIN=0.35
# Heure UTC du rapport quotidien Telegram
DAILY_REPORT_HOUR_UTC=7

# ----- Clean Sticky AAVE (clean_sticky_main.py) -----
# EMA 20/50 : vert=LONG, gris=ferme, rouge=SHORT | levier x10
CLEAN_STICKY_START_BALANCE=1000
CLEAN_STICKY_LEVERAGE=10
CLEAN_STICKY_POSITION_PCT=100
CLEAN_STICKY_TF_MIN=5
CLEAN_STICKY_EMA_FAST=20
CLEAN_STICKY_EMA_SLOW=50
